//The icon of every SecondShell executable: the first icon resource is the one Explorer and the taskbar show
1 ICON "SecondShell.ico"

//The version Explorer shows in the file's properties, from Build\SecondShell.Cpp.props
#include <winver.h>

1 VERSIONINFO
FILEVERSION SECONDSHELL_VERSION_NUMBER
PRODUCTVERSION SECONDSHELL_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Axodox"
      VALUE "FileDescription", "SecondShell"
      VALUE "FileVersion", SECONDSHELL_VERSION
      VALUE "ProductName", "SecondShell"
      VALUE "ProductVersion", SECONDSHELL_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
