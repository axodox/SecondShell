<?xml version="1.0" encoding="utf-8"?>
<!-- The action log (docs/UIDesign.md, Log flyout): filters and search, then one group per sequence, newest first -->
<UserControl
  x:Class="SecondShell.ActionLogPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="16,12,12,10" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Action log" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

      <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Show">
          <ToggleButton x:Name="AllFilter" Content="All" IsChecked="True" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
          <ToggleButton x:Name="FailedFilter" Content="Failed" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
          <ToggleButton x:Name="CapturesFilter" Content="Captures" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
          <ToggleButton x:Name="CommandsFilter" Content="Commands" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
        </StackPanel>
      </Border>

      <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search actions" FontSize="12" MinHeight="28" VerticalAlignment="Center"
               AutomationProperties.Name="Search the log" TextChanged="OnSearchChanged" />

      <Button x:Name="ExpandButton" Grid.Column="3" Style="{StaticResource PanelIconButtonStyle}" AutomationProperties.Name="Expand to the window's height" Click="OnExpandClick">
        <FontIcon x:Name="ExpandIcon" Glyph="&#xE740;" FontSize="13" />
      </Button>
      <Button Grid.Column="4" Style="{StaticResource PanelIconButtonStyle}" AutomationProperties.Name="Close the log" Click="OnCloseClick">
        <FontIcon Glyph="&#xE711;" FontSize="12" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Groups" Spacing="6" Padding="8,0,8,10">
        <TextBlock x:Name="EmptyText" Text="No agent actions yet." Margin="10" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
