<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, General (docs/ui/Settings.html): the session, captures, commands, sign-in and setup -->
<UserControl
  x:Class="SecondShell.GeneralSettings"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:SecondShell">
  <StackPanel Spacing="4">
    <TextBlock Text="General" Style="{StaticResource SettingsPageTitleStyle}" />

    <TextBlock Text="Session" Style="{StaticResource SettingsSectionTitleStyle}" />
    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Display" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="For new sessions; Set-Display changes a running one" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="ResolutionBox" Style="{StaticResource SettingsComboBoxStyle}" MinWidth="150" AutomationProperties.Name="Display resolution" SelectionChanged="OnChanged" />
        <ComboBox x:Name="ScaleBox" Style="{StaticResource SettingsComboBoxStyle}" MinWidth="100" AutomationProperties.Name="Display scale" SelectionChanged="OnChanged" />
      </StackPanel>
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Sign-in timeout" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="The driver starts with your startup apps, which can take over a minute" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <ComboBox x:Name="TimeoutBox" Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="Sign-in timeout" SelectionChanged="OnChanged" />
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Keep working while the screen is locked" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="WorkWhileLockedDetail" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <ToggleSwitch x:Name="WorkWhileLockedSwitch" Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="On" OffContent="Off" AutomationProperties.Name="Keep working while the screen is locked" Toggled="OnWorkWhileLockedToggled" />
    </Grid>

    <!-- Installed from the package only: the portable build always starts the driver the faster way -->
    <Grid x:Name="FasterStartCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Faster session start" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                   Text="Off: SecondShell's startup app starts the agent's desktop with the other startup apps, up to a minute or more after it signs in. On: a scheduled task starts it within seconds, while SecondShell runs; SecondShell removes the task when it closes." />
      </StackPanel>
      <ToggleSwitch x:Name="FasterStartSwitch" Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="On" OffContent="Off" AutomationProperties.Name="Faster session start" Toggled="OnWorkWhileLockedToggled" />
    </Grid>

    <TextBlock Text="Captures" Style="{StaticResource SettingsSectionTitleStyle}" />
    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Format" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="Of captures saved to files; captures sent inline are always PNG" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <ComboBox x:Name="FormatBox" Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="Capture format" SelectionChanged="OnChanged" />
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Inline captures per sequence" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="Beyond this, captures go to files and the agent gets their paths" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <NumberBox x:Name="InlineLimitBox" Grid.Column="1" Minimum="0" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"
                 MinWidth="140" AutomationProperties.Name="Inline captures per sequence" ValueChanged="OnInlineLimitChanged" />
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Capture files" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="CaptureFolderText" Style="{StaticResource SettingsPathStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Keep for" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
        <ComboBox x:Name="RetentionBox" Style="{StaticResource SettingsComboBoxStyle}" MinWidth="120" AutomationProperties.Name="Keep capture files for" SelectionChanged="OnChanged" />
        <Button Content="Open folder" Click="OnOpenCaptureFolderClick" />
      </StackPanel>
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Output files of processes" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="Programs the agent starts with their output collected, e.g. servers, write it to files of at most this size, then go on in the next" Style="{StaticResource SettingsDescriptionStyle}" />
        <TextBlock x:Name="OutputFolderText" Style="{StaticResource SettingsPathStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <NumberBox x:Name="OutputPartSizeBox" Minimum="1" Maximum="4096" SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline"
                   MinWidth="140" AutomationProperties.Name="Output file size in megabytes" ValueChanged="OnNumberChanged" />
        <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
        <Button Content="Open folder" Click="OnOpenOutputFolderClick" />
      </StackPanel>
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Space for captures and output files" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="Beyond it, the oldest captures and output files are deleted; 0: no limit" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <NumberBox x:Name="StorageLimitBox" Minimum="0" Maximum="1048576" SmallChange="256" LargeChange="1024" SpinButtonPlacementMode="Inline"
                   MinWidth="140" AutomationProperties.Name="Space for captures and output files in megabytes" ValueChanged="OnNumberChanged" />
        <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Commands" Style="{StaticResource SettingsSectionTitleStyle}" />
    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Default shell" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="For Process.Run when the agent names none" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <ComboBox x:Name="ShellBox" Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="Default shell" SelectionChanged="OnChanged" />
    </Grid>

    <TextBlock Text="Sign-in and setup" Style="{StaticResource SettingsSectionTitleStyle}" />
    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="PasswordTitle" Text="Password saved" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="PasswordDetail" Text="In Windows Credential Manager, encrypted for this app; used only to sign the session in" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <Button x:Name="ForgetPasswordButton" Grid.Column="1" Content="Forget saved password" VerticalAlignment="Center" Click="OnForgetPasswordClick" />
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="ChildSessionsTitle" Text="Child sessions enabled" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="ChildSessionsDetail" Text="Set up once for this PC" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <Button x:Name="SetupButton" Grid.Column="1" Content="Check again" VerticalAlignment="Center" Click="OnSetupClick" />
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Smooth session view (60 fps)" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="SmoothViewDetail" Text="Every Remote Desktop session on this PC is drawn at 60 fps instead of 30, from its next sign-in; incoming connections too. Changing it needs administrator rights." Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <ToggleSwitch x:Name="SmoothViewSwitch" Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="On" OffContent="Off" AutomationProperties.Name="Smooth session view" Toggled="OnSmoothViewToggled" />
    </Grid>

    <TextBlock Text="Uninstall" Style="{StaticResource SettingsSectionTitleStyle}" />
    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Remove SecondShell from this PC" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock Text="Takes it out of your AI apps, and can forget the password and delete its files; then the app can be deleted or uninstalled" Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
      <Button x:Name="UninstallButton" Grid.Column="1" Content="Remove&#x2026;" VerticalAlignment="Center" AutomationProperties.Name="Remove SecondShell" Click="OnUninstallClick" />
    </Grid>
  </StackPanel>
</UserControl>
