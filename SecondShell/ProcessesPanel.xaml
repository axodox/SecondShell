<?xml version="1.0" encoding="utf-8"?>
<!-- The Processes flyout (docs/UIDesign.md, Processes flyout): filters and search, the processes the agent started with
     output and the output files of earlier ones, and the selected one's output, live while it runs. The lines are rows
     of a repeater, which builds only those on the screen. -->
<UserControl
  x:Class="SecondShell.ProcessesPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="16,12,12,10" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Processes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

      <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Show">
          <ToggleButton x:Name="AllFilter" Content="All" IsChecked="True" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
          <ToggleButton x:Name="RunningFilter" Content="Running" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
          <ToggleButton x:Name="FinishedFilter" Content="Finished" Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
        </StackPanel>
      </Border>

      <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search processes" FontSize="12" MinHeight="28" VerticalAlignment="Center"
               AutomationProperties.Name="Search the processes" TextChanged="OnSearchChanged" />

      <Button x:Name="ExpandButton" Grid.Column="3" Style="{StaticResource PanelIconButtonStyle}" AutomationProperties.Name="Expand to the window's height" Click="OnExpandClick">
        <FontIcon x:Name="ExpandIcon" Glyph="&#xE740;" FontSize="13" />
      </Button>
      <Button Grid.Column="4" Style="{StaticResource PanelIconButtonStyle}" AutomationProperties.Name="Close the processes" Click="OnCloseClick">
        <FontIcon Glyph="&#xE711;" FontSize="12" />
      </Button>
    </Grid>

    <Grid Grid.Row="1" Padding="8,0,8,10" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The panel keeps the selection itself and marks it: the list's own selection moved by itself as the flyout opened -->
      <ListView x:Name="ProcessList" Grid.Column="0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProcessClick" AutomationProperties.Name="Process list" />

      <Grid Grid.Column="1" RowSpacing="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The selected one: what it is, and its output to copy or open -->
        <Grid Grid.Row="0" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DetailText" Grid.Column="0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button x:Name="CopyButton" Grid.Column="1" Content="Copy" Style="{StaticResource SmallButtonStyle}" IsEnabled="False"
                  AutomationProperties.Name="Copy the output" ToolTipService.ToolTip="Copy the output shown here" Click="OnCopyClick" />
          <Button x:Name="OpenFileButton" Grid.Column="2" Content="Open file" Style="{StaticResource SmallButtonStyle}" IsEnabled="False"
                  AutomationProperties.Name="Open the output file" ToolTipService.ToolTip="Open the file with all of the output" Click="OnOpenFileClick" />
        </Grid>

        <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource FieldBorderBrush}" Background="{StaticResource OutputBrush}">
          <Grid>
            <!-- Anchored at the end: while it shows the last line, it follows the new ones -->
            <ScrollViewer x:Name="OutputScroller" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalAnchorRatio="1" Padding="10,6">
              <ItemsRepeater x:Name="Lines">
                <ItemsRepeater.Layout>
                  <StackLayout />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextWrapping="NoWrap" />
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Margin="12" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="No processes yet. The agent starts one here with Process.Run, async and output, e.g. a server whose log it reads." />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
