<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, About: what SecondShell is, its version, and where it keeps its files -->
<UserControl
  x:Class="SecondShell.AboutSettings"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:SecondShell">
  <StackPanel Spacing="4">
    <TextBlock Text="About" Style="{StaticResource SettingsPageTitleStyle}" />

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- The app mark, as in the icon -->
      <Canvas Width="36" Height="36" VerticalAlignment="Center">
        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="22" Height="22" RadiusX="6" RadiusY="6" Fill="#3B3550" Stroke="#BEB4F0" StrokeThickness="1.5" />
        <Rectangle Canvas.Left="12" Canvas.Top="12" Width="22" Height="22" RadiusX="6" RadiusY="6" Fill="{StaticResource AgentBrush}" Stroke="#1B1B1F" StrokeThickness="1.5" />
      </Canvas>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="A second Windows desktop for AI agents: a child session of your own account, where they use apps without taking your mouse, keyboard or screen." Style="{StaticResource SettingsDescriptionStyle}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Files" Style="{StaticResource SettingsSectionTitleStyle}" />
    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Logs" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="LogFolderText" Style="{StaticResource SettingsPathStyle}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Open folder" VerticalAlignment="Center" Click="OnOpenLogFolderClick" />
    </Grid>

    <Grid Style="{StaticResource SettingsCardStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="MCP server" Style="{StaticResource SettingsNameStyle}" />
        <TextBlock x:Name="McpPathText" Style="{StaticResource SettingsPathStyle}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Copy path" VerticalAlignment="Center" Click="OnCopyMcpPathClick" />
    </Grid>
  </StackPanel>
</UserControl>
