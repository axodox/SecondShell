<?xml version="1.0" encoding="utf-8"?>
<!-- The MSIX package (Design.md, Deployment, MSIX); package.ps1 fills in $Version$ and $Architecture$.
     Full trust, write virtualization off (so the driver's RunOnce entry reaches Explorer and the data folder is the real
     one, as in the portable build), and an App Execution Alias per program, which AI apps and the RunOnce entry use. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 desktop6 rescap">

  <Identity Name="Axodox.SecondShell" Publisher="CN=Axodox" Version="$Version$" ProcessorArchitecture="$Architecture$" />

  <Properties>
    <DisplayName>SecondShell</DisplayName>
    <PublisherDisplayName>Axodox</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- The host: the window, and the start menu entry -->
    <Application Id="SecondShell" Executable="SecondShell.exe" EntryPoint="Windows.FullTrustApplication" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="SecondShell" Description="A second Windows desktop for AI agents"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="SecondShell.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="SecondShell.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>        <!-- The driver's startup task, under the host's app so the host can read its state (an app sees only its own
             startup tasks); it starts the driver's executable -->
        <desktop:Extension Category="windows.startupTask" Executable="SecondShell.Driver.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SecondShellDriver" Enabled="true" DisplayName="SecondShell driver" />
        </desktop:Extension>

      </Extensions>
    </Application>

    <!-- The MCP server, which AI apps start: a console program, one per AI app -->
    <Application Id="Mcp" Executable="SecondShell.Mcp.exe" EntryPoint="Windows.FullTrustApplication" desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="SecondShell MCP server" Description="The MCP server AI apps run" AppListEntry="none"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="SecondShell.Mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="SecondShell.Mcp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>

    <!-- The driver, which the child session's sign-in starts: the startup task (under the host's app, above), at every sign-in with the startup
         apps, removed with the package; and, if the user chooses the faster start (Settings), the host's scheduled task
         too. The driver exits at once where it is not wanted, and the host keeps the first. -->
    <Application Id="Driver" Executable="SecondShell.Driver.exe" EntryPoint="Windows.FullTrustApplication" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="SecondShell driver" Description="Runs in the agent's desktop" AppListEntry="none"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="SecondShell.Driver.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="SecondShell.Driver.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
