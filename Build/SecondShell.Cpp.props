<?xml version="1.0" encoding="utf-8"?>
<!-- Compiler and output settings shared by all C++ projects. Imported as a property sheet, after Microsoft.Cpp.props. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The version of every binary and package (ProductInfo, the version resource, package.ps1): <major>.<minor>.<build>.<revision>,
       the build being CI's build number (ci.ps1 sets SecondShellBuild in the environment; 0 for local builds) and the
       revision mostly 0. SecondShellVersion is the short form, without a revision of 0: the one shown, and the one in
       the file names and the release tags -->
  <PropertyGroup>
    <SecondShellMajorMinor>1.0</SecondShellMajorMinor>
    <SecondShellBuild Condition="'$(SecondShellBuild)' == ''">0</SecondShellBuild>
    <SecondShellRevision Condition="'$(SecondShellRevision)' == ''">0</SecondShellRevision>
    <SecondShellVersion>$(SecondShellMajorMinor).$(SecondShellBuild)</SecondShellVersion>
    <SecondShellVersion Condition="'$(SecondShellRevision)' != '0'">$(SecondShellVersion).$(SecondShellRevision)</SecondShellVersion>
    <SecondShellVersionNumber>$(SecondShellMajorMinor.Replace('.', ',')),$(SecondShellBuild),$(SecondShellRevision)</SecondShellVersionNumber>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(SecondShellRoot)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SecondShellRoot)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PreprocessorDefinitions>NOMINMAX;UNICODE;_UNICODE;SECONDSHELL_VERSION="$(SecondShellVersion)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>SECONDSHELL_VERSION=\"$(SecondShellVersion)\";SECONDSHELL_VERSION_NUMBER=$(SecondShellVersionNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
