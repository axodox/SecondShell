<?xml version="1.0" encoding="utf-8"?>
<!-- Packages used by every C++ project: C++/WinRT. Imported at the top of each project. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)Packages.props" />
  <Import Project="$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.props')" />
</Project>
